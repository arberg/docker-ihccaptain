# Container images. Set IHCCAPTAIN_IMAGE to a versioned tag to pin releases.
IHCCAPTAIN_IMAGE=arberg/ihccaptain:latest
IHCCAPTAIN_DEBUG_IMAGE=arberg/ihccaptain:auto

# Published web interface ports.
IHCCAPTAIN_HTTP_PORT=8100
IHCCAPTAIN_HTTPS_PORT=9100

# Existing persistent Unraid data locations.
IHCCAPTAIN_DATA_DIR=/mnt/user/docker/ihccaptain/data
IHCCAPTAIN_HOST_DIR=/mnt/user/docker/ihccaptain/host
